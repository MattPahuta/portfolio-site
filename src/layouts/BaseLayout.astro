---
import "../styles/global.css";
import { Seo } from "astro-seo-meta";
const { title = "Matt Pahuta | Web Developer" } = Astro.props;
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <!-- <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"> -->
    <meta name="generator" content={Astro.generator} />
    <Seo
      title="Matt Pahuta"
      keywords={["website", "portfolio", "astro", "developer"]}
      description="Frontend developer skilled with React and Tailwind CSS, focussed on accessibility and inclusive design."
      icon="/favicon-32x32.png"
    />
    <Font cssVariable="--font-ubuntu" />
  </head>
  <body
    class="min-h-dvh font-sans bg-midnight-oil text-zinc-200 scroll-smooth">
    <div class="mx-auto max-w-4xl px-4 sm:px-5">
      <slot />
    </div>
  </body>
</html>
