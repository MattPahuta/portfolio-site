---
import SocialLinksList from "./SocialLinksList.astro";
import { Image } from "astro:assets";
import avatar from "../assets/avatar_v1.jpg";
import { Icon } from "astro-icon/components";
const socialLinks = [
  {
    label: "Email",
    href: "mailto:mhpahuta@gmail.com",
    iconName: "mail",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/mattpahuta",
    iconName: "linkedin",
  },
  {
    label: "GitHub",
    href: "https://github.com/MattPahuta",
    iconName: "github",
  },
];

const heroStats = [
  { label: "focus", value: "accessible development", colorClass: "" },
  { label: "library", value: "React", colorClass: "" },
  { label: "approach", value: "clean & practical", colorClass: "" },
  { label: "status", value: "building", colorClass: "" },
];

const skills = [
  "React",
  "JavaScript",
  "TypeScript",
  "Astro",
  "Tailwind CSS",
];
---

<section class="py-10 space-y-6">
  <!-- hero shell -->
  <div class="sm:p-5 md:p-10 lg:p-4">
    <!-- hero top grid -->
    <div class="mb-6 lg:mb-10 flex flex-col items-start">
      <div class="mb-6">
        <!-- <p
          class="mb-6 text-xs sm:text-sm font-mono tracking-wide uppercase text-accent">
          accessibility-focused frontend engineer
        </p> -->
        <p class="mb-2 text-lg text-zinc-300">Hi, I'm Matt!</p>
        <h1 class="max-w-[24ch] text-4xl sm:text-6xl lg:text-5xl">
          I build thoughtful frontend experiences with accessibility
          at the core.
        </h1>
      </div>

      <Image
        src={avatar}
        alt="Headshot of Matt Pahuta"
        priority
        class="size-36 md:size-40 rounded-full object-cover -order-1"
      />
    </div>

    <div
      class="space-y-2 max-w-prose text-pretty text-lg sm:text-xl leading-relaxed">
      <!-- CTA button links -->
      <div class="mt-10">
        <ul
          class="text-sm sm:text-base flex flex-wrap items-center justify-start gap-3 md:gap-4">
          {
            socialLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="py-2 px-4 inline-flex items-center gap-2 border border-accent text-gray-200 hover:bg-raised-bg hover:translate-y-[-2px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition duration-300">
                  <Icon
                    name={item.iconName}
                    aria-hidden="true"
                    focusable="false"
                    class="size-4"
                  />
                  <span class="">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p>
        I'm a frontend engineer focused on building responsive
        interfaces with React, Astro, and Tailwind CSS, with
        accessibility and usability considered from the start.
      </p>
      <p>
        My background in technology, business analysis, and project
        management helps me bridge the gap between technical
        solutions, team collaboration, and user needs.
      </p>
    </div>
  </div>
</section>

