---
import { Icon } from "astro-icon/components";
const socialLinks = [
  {
    label: "Email",
    href: "mailto:mhpahuta@gmail.com",
    iconName: "mail",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/mattpahuta",
    iconName: "linkedin",
  },
  {
    label: "GitHub",
    href: "https://github.com/MattPahuta",
    iconName: "github",
  },
];
---

<ul
  class="font-ubuntu font-medium flex flex-wrap items-center justify-center start gap-3 md:gap-4">
  {
    socialLinks.map((item) => (
      <li>
        <a
          href={item.href}
          class="py-2 px-4 inline-flex items-center justify-center gap-2 border-2 rounded-lg   border-accent text-gray-200 hover:bg-accent hover:text-midnight-oil focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition-colors">
          <Icon
            name={item.iconName}
            aria-hidden="true"
            focusable="false"
            class="size-5"
          />
          {item.label}
        </a>
      </li>
    ))
  }
</ul>
