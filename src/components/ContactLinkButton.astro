---
import { Icon } from "astro-icon/components";
const { label, handle, href, iconName, iconSize } = Astro.props;
---

<a
  href=`${href}`
  target="_blank"
  rel="noreferrer noopener"
  class="group w-full py-2 px-4 inline-flex items-center gap-4 rounded-lg border border-gray-500 bg-transparent hover:bg-accent hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition">
  <div class="p-3 rounded-lg bg-gray-800 group-hover:bg-gray-900">
    <Icon
      name=`${iconName}`
      aria-hidden="true"
      focusable="false"
      class=`${iconSize} text-gray-200 group-hover:text-accent`
    />
  </div>
  <div class="flex flex-col">
    <span
      class="text-gray-200 font-semibold group-hover:text-midnight-oil transition-colors"
      >{label}</span
    >
    <span
      class="text-sm text-gray-400 group-hover:text-midnight-oil transition-colors"
      >{handle}</span
    >
  </div>
</a>
