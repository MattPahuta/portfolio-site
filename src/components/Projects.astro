---
import ProjectCard from "./ProjectCard.astro";
import ProjectCardAlt from "./ProjectCardAlt.astro";
import { getCollection } from "astro:content";
const projects = await getCollection("project");
import { Icon } from "astro-icon/components";
---

<section id="projects">
  <h2
    class="mb-8 pl-4 sm:mb-16 text-3xl md:text-4xl font-ubuntu font-semibold text-zinc-50 whitespace-nowrap">
    Featured Projects
  </h2>

  <div class="mb-12 space-y-6">
    {
      projects.map((project) => (
        <ProjectCardAlt
          title={project.data.title}
          description={project.data.description}
          imagePath={project.data.imagePath}
          imageAltText={project.data.imageAltText}
          techStack={project.data.techStack}
          gitHubUrl={project.data.gitHubUrl}
          liveSiteUrl={project.data.liveSiteUrl}
        />
      ))
    }
  </div>
  <h3
    class="mb-8 text-center text-xl text-gray-300 font-ubuntu font-light">
    Find more of my work on GitHub or Frontend Mentor
  </h3>
  <div
    class="text-base flex flex-col sm:flex-row gap-4 items-center justify-center">
    <a
      href="https://github.com/MattPahuta"
      target="_blank"
      rel="noreferrer noopener"
      class="py-2 px-4 inline-flex items-center justify-center gap-2 rounded-lg border-2 border-accent hover:bg-accent hover:text-midnight-oil focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition-colors">
      <Icon
        name="github"
        aria-hidden="true"
        focusable="false"
        class="size-4"
      />
      GitHub
    </a>
    <a
      href="https://www.frontendmentor.io/profile/MattPahuta"
      target="_blank"
      rel="noreferrer noopener"
      class="py-2 px-4 inline-flex items-center justify-center gap-2 rounded-lg border-2 border-accent hover:bg-accent hover:text-midnight-oil focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition-colors">
      <Icon
        name="frontendmentor"
        aria-hidden="true"
        focusable="false"
        class="size-4"
      />
      Frontend Mentor
    </a>
  </div>
</section>
