---
const navMenuItems = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="py-4 sm:py-6 text-zinc-300 flex gap-5 items-center justify-between flex-wrap">
  <a
    href="/"
    class="inline-flex items-center gap-2 text-xl font-semibold font-ubuntu tracking-wide text-zinc-100 hover:text-accent focus:outline-accent focus:outline-2 outline-offset-4 transition">
    Matt Pahuta
    <span class="text-gray-400 font-mono font-light text-base"
      >/ Frontend Engineer</span
    >
  </a>
  <nav
    class="w-full sm:w-auto pt-4 sm:pt-0 font-med text-lg text-gray-300 border-t border-zinc-700 sm:border-t-0"
    aria-label="Primary">
    <ul class="flex items-center justify-center gap-4">
      {
        navMenuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex px-2 py-1 border-b-2 border-transparent hover:border-accent hover:text-accent focus-visible:outline-3 focus-visible:outline-offset-4 outline-accent transition">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
